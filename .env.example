# TrustVault Environment Configuration Example
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=trustvault-dev-secret-key-change-in-production-min32bytes!
JWT_SECRET_KEY=trustvault-jwt-dev-secret-key-min32bytes!
JWT_EXPIRATION_HOURS=8
DATABASE_URL=sqlite:///instance/trustvault.db
# DATABASE_URL=postgresql://trustuser:securepassword@localhost:5432/trustvault
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=15728640
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=5000
